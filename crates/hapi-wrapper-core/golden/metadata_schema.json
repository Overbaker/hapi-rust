      "required": [
        "operationId",
        "nativeSessionId",
        "workerId",
        "requestedLocalId",
        "nativeMessageId",
        "cutoffSeq",
        "sourceEpoch",
        "sourceMaxSeq",
        "reservationVersion",
        "sourceTranscriptHash",
        "phase"
