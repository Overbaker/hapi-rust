            "archiveReason": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "state",
        "machineId",
        "startedAt"
      ]
    },
    "ptyResumeAttempt": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
