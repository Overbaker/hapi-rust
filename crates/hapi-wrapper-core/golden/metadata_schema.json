        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "workerPid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "workerStartMarker": {
          "type": "string",
          "minLength": 1
        },
        "requestedLocalId": {
          "type": "string",
          "minLength": 1
        },
        "nativeMessageId": {
          "type": "string",
          "minLength": 1
        },
        "cutoffSeq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceMaxSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservationVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceTranscriptHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "reserved",
            "prepared",
            "unknown",
            "committed",
            "rejected"
          ]
        },
        "sourceHash": {
          "type": "string"
