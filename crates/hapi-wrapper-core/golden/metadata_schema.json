        "bindingId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "state": {
          "type": "string",
          "enum": [
            "attached",
            "detached",
            "unavailable",
            "history-changed"
          ]
        }
      },
      "required": [
        "kind",
        "bindingId",
        "state"
      ]
    },
    "codexSourceSessionId": {
      "type": "string"
    },
    "codexImportedAt": {
      "type": [
        "number",
        "null"
      ]
    },
    "geminiSessionId": {
      "type": "string"
    },
    "opencodeSessionId": {
      "type": "string"
    },
    "grokSessionId": {
      "type": "string"
