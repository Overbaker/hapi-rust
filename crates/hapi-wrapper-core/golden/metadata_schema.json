            "type": "string",
            "enum": [
              "open",
              "closed",
              "merged",
              "draft"
            ]
          },
          "checks": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "pending",
              "none",
              "unknown"
            ]
          },
          "merge": {
            "type": "string",
            "enum": [
              "clean",
              "conflicting",
              "blocked",
              "behind",
              "unstable",
              "draft",
              "unknown"
            ]
          },
          "statusCheckedAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "estateCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "kind",
          "repo",
          "number",
          "url",
          "role"
        ]
      },
      "x-hapi-external-refs": true
    },
