        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          }
        },
        "required": [
          "modelId"
        ],
        "additionalProperties": {}
      }
    },
    "piSelectedModel": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
