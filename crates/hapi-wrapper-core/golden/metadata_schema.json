            "resuming",
            "quarantined"
          ]
        },
        "machineId": {
          "type": "string"
        },
        "startedAt": {
          "type": "number"
        },
        "archiveSnapshot": {
          "type": "object",
          "properties": {
            "lifecycleState": {
              "type": "string"
            },
            "lifecycleStateSince": {
              "type": "number"
            },
            "archivedBy": {
              "type": "string"
            },
            "archiveReason": {
              "type": "string"
            }
          }
        }
      },
