          "type": "string"
        },
        "piSessionId": {
          "type": "string"
        },
        "sourceFile": {
          "type": "string"
        },
        "startedAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "leafEntryId": {
          "type": [
            "string",
