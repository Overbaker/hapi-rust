          "enum": [
            "launching",
            "started",
            "uncertain"
          ]
        },
        "createdAt": {
          "type": "number"
        },
        "messageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workspace": {
          "type": "string",
          "enum": [
            "current",
            "worktree"
          ]
        }
      },
      "required": [
        "sourceSessionId",
        "boundary",
        "mode",
        "requestFingerprint",
        "state",
        "createdAt",
        "messageCount",
        "workspace"
      ]
