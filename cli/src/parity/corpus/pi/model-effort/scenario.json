{
  "flavor": "pi",
  "argv": [
    "pi",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "rpc": "set-session-config",
      "params": {
        "model": {
          "provider": "test",
          "modelId": "p1"
        },
        "effort": "high"
      },
      "expectAck": {
        "applied": {
          "model": {
            "provider": "test",
            "modelId": "p1"
          },
          "effort": "high"
        }
      }
    },
    {
      "signal": "SIGTERM",
      "settledAlive": {
        "mode": "remote",
        "effort": "high"
      }
    }
  ],
  "agentScript": "agent.json",
  "timeoutMs": 30000
}
