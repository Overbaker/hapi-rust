{
  "flavor": "pi",
  "argv": [
    "pi",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "hello"
            }
          }
        }
      },
      "until": {
        "event": "message",
        "contains": "hello pi"
      }
    },
    {
      "signal": "SIGTERM",
      "settledAlive": {
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.json",
  "timeoutMs": 30000
}
