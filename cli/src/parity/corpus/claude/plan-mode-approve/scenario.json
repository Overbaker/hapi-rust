{
  "flavor": "claude",
  "argv": [
    "claude",
    "--hapi-starting-mode",
    "remote",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111",
    "--permission-mode",
    "plan"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "hello"
            }
          }
        }
      },
      "until": {
        "event": "update-state",
        "contains": "\"tool-1\":"
      }
    },
    {
      "rpc": "permission",
      "params": {
        "id": "tool-1",
        "approved": true
      },
      "until": {
        "event": "message",
        "contains": "\"type\":\"ready\""
      }
    },
    {
      "signal": "SIGTERM"
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 20000
}
