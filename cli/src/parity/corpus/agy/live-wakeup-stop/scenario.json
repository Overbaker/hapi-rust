{
  "flavor": "agy",
  "argv": [
    "agy",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "start"
            }
          }
        }
      },
      "release": [
        {
          "after": [
            {
              "event": "message",
              "contains": "\"type\":\"ready\""
            },
            {
              "event": "update-state",
              "contains": "\"steeringActive\":false",
              "result": "success"
            }
          ],
          "marker": "first-turn-ready"
        }
      ],
      "until": [
        {
          "event": "message",
          "contains": "Working"
        }
      ]
    },
    {
      "rpc": "abort",
      "params": {},
      "release": [
        {
          "after": [
            {
              "event": "message",
              "contains": "Turn aborted"
            },
            {
              "event": "message",
              "contains": "\"type\":\"ready\""
            }
          ],
          "marker": "stopped"
        }
      ],
      "until": [
        {
          "event": "message",
          "contains": "AFTER"
        }
      ]
    },
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-2",
          "localId": "local-2",
          "seq": 2,
          "createdAt": 2,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "Reply with only OK."
            }
          }
        }
      },
      "until": [
        {
          "event": "message",
          "contains": "\"type\":\"ready\""
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":false",
          "result": "success"
        }
      ]
    },
    {
      "signal": "SIGTERM",
      "settledAlive": {
        "mode": "remote",
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 60000
}
