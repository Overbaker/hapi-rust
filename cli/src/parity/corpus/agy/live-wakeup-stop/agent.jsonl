{"config": {"initialize": {"protocolVersion": 1, "agentInfo": {"name": "agy", "version": "1.5.13"}, "agentCapabilities": {"loadSession": false, "promptCapabilities": {"image": false}, "sessionCapabilities": {"resume": {}, "list": {}}}, "authMethods": []}}}
{"await": "session/prompt", "as": "first"}
{"notify": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "STARTED"}}}
{"transcript": {"step_index": 0, "source": "USER_EXPLICIT", "type": "USER_INPUT", "content": "start"}}
{"transcript": {"step_index": 1, "source": "MODEL", "type": "PLANNER_RESPONSE", "status": "DONE", "content": "STARTED"}}
{"sleep": 30}
{"reply": {"stopReason": "end_turn", "usage": {"inputTokens": 40, "outputTokens": 10}}, "to": "first"}
{"awaitMarker": "first-turn-ready"}
{"transcript": {"step_index": 2, "source": "SYSTEM", "type": "SYSTEM_MESSAGE", "status": "DONE", "content": "<SYSTEM_MESSAGE>Subagent finished</SYSTEM_MESSAGE>"}}
{"notify": {"sessionUpdate": "tool_call", "toolCallId": "call-wake-1", "name": "run_command", "title": "sleep 30", "status": "in_progress", "rawInput": {"CommandLine": "sleep 30"}}}
{"notify": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Working"}}}
{"awaitMarker": "stopped"}
{"notify": {"sessionUpdate": "tool_call", "toolCallId": "call-wake-1", "name": "run_command", "title": "sleep 30", "status": "in_progress", "rawInput": {"CommandLine": "sleep 30"}}}
{"notify": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "AFTER"}}}
{"await": "session/prompt", "as": "second"}
{"notify": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "OK"}}}
{"sleep": 30}
{"reply": {"stopReason": "end_turn", "usage": {"inputTokens": 20, "outputTokens": 2}}, "to": "second"}
