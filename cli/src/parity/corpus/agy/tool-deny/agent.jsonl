{"await": "session/prompt", "as": "main"}
{"notify": {"sessionUpdate": "user_message_chunk", "content": {"type": "text", "text": "run it"}}}
{"notify": {"sessionUpdate": "tool_call", "toolCallId": "call_1", "name": "run_command", "args": {"CommandLine": "echo hi", "WaitMsBeforeAsync": 500}, "status": "pending", "kind": "execute", "title": "echo hi", "rawInput": {"CommandLine": "echo hi", "WaitMsBeforeAsync": 500}}}
{"request": "session/request_permission", "params": {"toolCall": {"toolCallId": "call_1", "title": "echo hi", "kind": "execute", "rawInput": {"CommandLine": "echo hi", "WaitMsBeforeAsync": 500}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}, "expect": {"outcome": {"outcome": "selected", "optionId": "reject"}}}
{"notify": {"sessionUpdate": "tool_call_update", "toolCallId": "call_1", "name": "run_command", "args": {"CommandLine": "echo hi", "WaitMsBeforeAsync": 500}, "status": "failed", "kind": "execute", "title": "echo hi", "rawInput": {"CommandLine": "echo hi", "WaitMsBeforeAsync": 500}, "rawOutput": {"error": "The user rejected the command."}}}
{"notify": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "I did not run it."}}}
{"sleep": 30}
{"reply": {"stopReason": "end_turn", "usage": {"inputTokens": 120, "outputTokens": 7, "cachedReadTokens": 0, "cachedWriteTokens": 0, "thoughtTokens": 3, "totalTokens": 130}}, "to": "main"}
