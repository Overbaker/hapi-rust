{
  "flavor": "agy",
  "argv": [
    "agy",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "rpc": "set-session-config",
      "params": {
        "permissionMode": "acceptEdits"
      },
      "expectAck": {}
    },
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "hello"
            }
          }
        }
      },
      "until": [
        {
          "event": "message",
          "contains": "\"type\":\"ready\""
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":false",
          "result": "success"
        }
      ]
    },
    {
      "signal": "SIGTERM",
      "settledAlive": {
        "mode": "remote",
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 60000
}
