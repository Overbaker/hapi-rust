{
  "flavor": "agy",
  "argv": [
    "agy",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "hello"
            }
          }
        }
      },
      "until": [
        {
          "event": "message",
          "contains": "Recorded answer"
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":true",
          "result": "success"
        }
      ]
    },
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-2",
          "localId": "local-2",
          "seq": 2,
          "createdAt": 2,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "follow up"
            }
          }
        }
      }
    },
    {
      "rpc": "steer-queued-message",
      "params": {
        "localId": "local-2"
      },
      "expectAck": {
        "steered": true
      },
      "until": [
        {
          "event": "message",
          "contains": "\"type\":\"ready\""
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":false",
          "result": "success"
        },
        {
          "event": "messages-consumed",
          "contains": "local-2"
        },
        {
          "event": "message",
          "contains": "Steered answer"
        }
      ]
    },
    {
      "signal": "SIGTERM",
      "settledAlive": {
        "mode": "remote",
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 60000
}
