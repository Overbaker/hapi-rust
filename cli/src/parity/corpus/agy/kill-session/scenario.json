{
  "flavor": "agy",
  "argv": [
    "agy",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "rpc": "killSession",
      "params": {
        "expectedMachineId": "other-machine"
      },
      "expectAck": {
        "error": "Session machine does not match shutdown target"
      }
    },
    {
      "rpc": "killSession",
      "params": {
        "expectedPid": "$pid",
        "expectedProcessStartMarker": "$marker"
      },
      "expectAck": {
        "success": true
      },
      "settledAlive": {
        "mode": "remote",
        "thinking": false
      }
    }
  ],
  "agentScript": "agent.jsonl",
  "timeoutMs": 60000
}
