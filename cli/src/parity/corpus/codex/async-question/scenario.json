{
  "flavor": "codex",
  "argv": [
    "codex",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "ask?"
            }
          }
        }
      },
      "until": [
        {
          "event": "update-state",
          "contains": "\"isBlocking\":false"
        }
      ]
    },
    {
      "rpc": "permission",
      "params": {
        "id": "$permissionId",
        "approved": true,
        "answers": {
          "[\"request_user_input_async\",\"question\",0]": [
            "Blue"
          ]
        }
      },
      "until": [
        {
          "event": "message",
          "contains": "\"type\":\"turn_duration\""
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":false"
        },
        {
          "event": "messages-consumed",
          "contains": "codex:thread-1:duration:turn-1"
        },
        {
          "event": "update-metadata",
          "contains": "\"forkLatestCompleted\":true",
          "result": "success"
        }
      ]
    },
    {
      "signal": "SIGTERM"
    }
  ],
  "agentScript": "agent.json",
  "timeoutMs": 30000
}
