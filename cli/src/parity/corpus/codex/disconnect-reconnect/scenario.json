{
  "flavor": "codex",
  "argv": [
    "codex",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "hello"
            }
          }
        }
      },
      "until": [
        {
          "event": "message",
          "contains": "\"type\":\"turn_duration\""
        },
        {
          "event": "update-state",
          "contains": "\"steeringActive\":false"
        },
        {
          "event": "messages-consumed",
          "contains": "codex:thread-1:duration:turn-1"
        },
        {
          "event": "update-metadata",
          "contains": "\"forkLatestCompleted\":true",
          "result": "success"
        }
      ]
    },
    {
      "dropConnection": 200,
      "until": [
        {
          "event": "session-ready"
        },
        {
          "event": "GET /cli/sessions/a1111111-1111-4111-8111-111111111111/messages"
        },
        {
          "event": "update-state",
          "result": "success",
          "count": 3
        },
        {
          "event": "update-metadata",
          "result": "success",
          "count": 2
        }
      ]
    },
    {
      "signal": "SIGTERM"
    }
  ],
  "agentScript": "agent.json",
  "timeoutMs": 30000
}
