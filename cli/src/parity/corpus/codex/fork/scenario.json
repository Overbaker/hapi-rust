{
  "flavor": "codex",
  "argv": [
    "codex",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "rpc": "fork-conversation",
      "params": {},
      "until": [
        {
          "event": "POST /session-started"
        }
      ]
    },
    {
      "rpc": "killSession",
      "target": "sibling",
      "params": {},
      "until": [
        {
          "event": "POST /session-started",
          "contains": "archived"
        },
        {
          "event": "session-end"
        }
      ]
    },
    {
      "signal": "SIGTERM"
    }
  ],
  "agentScript": "agent.json",
  "timeoutMs": 30000
}
