{
  "flavor": "codex",
  "argv": [
    "codex",
    "--started-by",
    "runner",
    "--hapi-session-id",
    "a1111111-1111-4111-8111-111111111111"
  ],
  "env": {},
  "hubScript": [
    {
      "sendUpdate": {
        "t": "new-message",
        "message": {
          "id": "message-1",
          "localId": "local-1",
          "seq": 1,
          "createdAt": 1,
          "content": {
            "role": "user",
            "content": {
              "type": "text",
              "text": "/new"
            }
          }
        }
      },
      "until": [
        {
          "event": "POST /session-started"
        },
        {
          "event": "messages-consumed",
          "contains": "local-1"
        }
      ]
    },
    {
      "rpc": "killSession",
      "target": "sibling",
      "params": {},
      "until": [
        {
          "event": "POST /session-started",
          "contains": "archived"
        },
        {
          "event": "session-end"
        }
      ]
    },
    {
      "signal": "SIGTERM"
    }
  ],
  "agentScript": "agent.json",
  "timeoutMs": 30000
}
